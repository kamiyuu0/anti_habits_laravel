APP_NAME="Anti Habits"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# 「今日」の判定・画面表示に使うタイムゾーン (DB の日時は UTC で保存)
APP_DISPLAY_TIMEZONE=Asia/Tokyo

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (Rails 版と同じ DB をそのまま利用できる)
# 本番では DB_URL=postgres://user:pass@host:5432/dbname の形式でも指定可能
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=myapp_development
DB_USERNAME=postgres
DB_PASSWORD=password

# 既存スキーマに追加テーブルを作らないため、セッション・キャッシュ・キューは DB を使わない
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=file
CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# メール送信 (本番は Gmail SMTP)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# MAIL_USERNAME=   # 未指定なら GMAIL_USERNAME
# MAIL_PASSWORD=   # 未指定なら GMAIL_PASSWORD
# 未指定の場合は GMAIL_USERNAME (Rails 版の環境変数) を使用
# MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# LINE ログイン (Rails 版と同じ環境変数名)
LINE_KEY=
LINE_SECRET=
# LINE Developers に登録済みのコールバック URL (既定: APP_URL/users/auth/line/callback)
LINE_REDIRECT_URI="${APP_URL}/users/auth/line/callback"

# LINE Messaging API (通知)
LINE_CHANNEL_TOKEN=

VITE_APP_NAME="${APP_NAME}"
